generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  banExpires    DateTime?
  banReason     String?
  banned        Boolean?  @default(false)
  role          String?
  accounts      Account[]
  chats         Chat[]
  files         File[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Chat {
  id             String    @id @default(cuid())
  title          String?
  activeStreamId String?   @map("active_stream_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  userId         String?   @map("user_id")
  isPinned       Boolean   @default(false)
  user           User?     @relation(fields: [userId], references: [id])
  files          File[]
  messages       Message[]

  @@index([userId])
  @@index([isPinned])
  @@index([updatedAt])
  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String   @map("chat_id")
  role      String
  content   String
  parts     Json
  createdAt DateTime @default(now()) @map("created_at")
  files     File[]
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
  @@map("messages")
}

model File {
  id            String   @id @default(cuid())
  name          String
  size          Int
  mimeType      String
  path          String
  storageKey    String
  url           String?
  description   String?
  pageCount     Int?
  extractedText String?
  metadata      Json?
  userId        String
  chatId        String?
  messageId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chat          Chat?    @relation(fields: [chatId], references: [id])
  message       Message? @relation(fields: [messageId], references: [id])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
  @@index([messageId])
  @@index([createdAt])
  @@index([mimeType])
  @@map("files")
}

model SourceDocument {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content               String                  @unique
  filename              String
  source                String
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  source_url            String?
  SourceDocumentSegment SourceDocumentSegment[]

  @@map("SourceDocument")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model SourceDocumentSegment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content          String
  sourceDocumentid String         @db.Uuid
  vector           Unsupported("vector")
  createdAt        DateTime?      @default(now()) @db.Timestamp(6)
  chunk_index      Int
  page_number      Int?
  tags             Json?          @default("[]")
  article_number   Int?           @default(0)
  SourceDocument   SourceDocument @relation(fields: [sourceDocumentid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sourceDocumentid], map: "idx_segment_document_id")
  @@index([tags], map: "idx_segment_tags", type: Gin)
  @@index([vector], map: "idx_source_document_segment_vector")
  @@map("SourceDocumentSegment")
}
